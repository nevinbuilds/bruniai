{
  "name": "bruniai-mcp-server",
  "version": "0.1.11",
  "type": "module",
  "description": "MCP server for BruniAI visual comparison functionality",
  "author": "Joao Garin",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bruniai-mcp-server": "./dist/mcp-server.js"
  },
  "exports": {
    ".": {
