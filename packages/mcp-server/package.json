  "scripts": {
    "build": "npm --prefix ../bruniai run build && tsc",
    "dev": "tsx src/mcp-server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.1",
    "bruniai": "0.1.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4"
  }
}
